rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFolderProgress(data, userId, folderId) {
      return data.keys().hasAll(['ownerId', 'folderId', 'folderName', 'keepCount', 'trashCount', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'folderId', 'folderName', 'keepCount', 'trashCount', 'lastShotId', 'lastShotName', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.folderId is string
        && data.folderId == folderId
        && isValidId(data.folderId)
        && data.folderName is string
        && data.folderName.size() >= 1
        && data.folderName.size() <= 256
        && data.keepCount is int
        && data.keepCount >= 0
        && data.keepCount <= 500000
        && data.trashCount is int
        && data.trashCount >= 0
        && data.trashCount <= 500000
        && (!('lastShotId' in data) || (data.lastShotId is string && data.lastShotId.size() >= 1 && data.lastShotId.size() <= 256))
        && (!('lastShotName' in data) || (data.lastShotName is string && data.lastShotName.size() >= 1 && data.lastShotName.size() <= 256))
        && data.updatedAt == request.time;
    }

    function isValidDecisionChunk(data, userId, folderId) {
      return data.keys().hasAll(['ownerId', 'folderId', 'entries', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'folderId', 'entries', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.folderId is string
        && data.folderId == folderId
        && isValidId(data.folderId)
        && data.entries is map
        && data.entries.size() <= 1000
        && data.updatedAt == request.time;
    }

    function isValidCalibrationMap(cal) {
      return cal is map
        && cal.keys().hasAll(['minScore', 'minStruct', 'minCenter', 'minEdge', 'minSpatialColor', 'minCenterColor', 'maxMeanLumaDiff', 'sameCount', 'differentCount', 'accuracyPct', 'updatedAt'])
        && cal.keys().hasOnly(['minScore', 'minStruct', 'minCenter', 'minEdge', 'minSpatialColor', 'minCenterColor', 'maxMeanLumaDiff', 'sameCount', 'differentCount', 'accuracyPct', 'updatedAt'])
        && cal.minScore is number && cal.minScore >= 0.0 && cal.minScore <= 1.0
        && cal.minStruct is number && cal.minStruct >= 0.0 && cal.minStruct <= 1.0
        && cal.minCenter is number && cal.minCenter >= 0.0 && cal.minCenter <= 1.0
        && cal.minEdge is number && cal.minEdge >= 0.0 && cal.minEdge <= 1.0
        && cal.minSpatialColor is number && cal.minSpatialColor >= 0.0 && cal.minSpatialColor <= 1.0
        && cal.minCenterColor is number && cal.minCenterColor >= 0.0 && cal.minCenterColor <= 1.0
        && cal.maxMeanLumaDiff is number && cal.maxMeanLumaDiff >= 0.0 && cal.maxMeanLumaDiff <= 1.0
        && cal.sameCount is int && cal.sameCount >= 0 && cal.sameCount <= 10000
        && cal.differentCount is int && cal.differentCount >= 0 && cal.differentCount <= 10000
        && cal.accuracyPct is int && cal.accuracyPct >= 0 && cal.accuracyPct <= 100
        && cal.updatedAt is int && cal.updatedAt >= 0;
    }

    function isValidCalibrationPreference(data, userId, prefId) {
      return data.keys().hasAll(['ownerId', 'prefId', 'baseSensitivity', 'examples', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'prefId', 'baseSensitivity', 'calibration', 'examples', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.prefId is string
        && data.prefId == prefId
        && prefId == 'seriesCalibration'
        && data.baseSensitivity in ['strict', 'balanced', 'loose']
        && (!('calibration' in data) || isValidCalibrationMap(data.calibration))
        && data.examples is list
        && data.examples.size() <= 60
        && data.updatedAt == request.time;
    }

    function isValidManualSeriesDoc(data, userId, folderId, seriesId) {
      return data.keys().hasAll(['ownerId', 'folderId', 'seriesId', 'shotIds', 'stems', 'updatedAtMs', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'folderId', 'seriesId', 'shotIds', 'stems', 'updatedAtMs', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.folderId is string
        && data.folderId == folderId
        && isValidId(data.folderId)
        && data.seriesId is string
        && data.seriesId == seriesId
        && isValidId(data.seriesId)
        && data.shotIds is list
        && data.shotIds.size() >= 2
        && data.shotIds.size() <= 200
        && data.shotIds[0] is string
        && data.stems is list
        && data.stems.size() >= 2
        && data.stems.size() <= 200
        && data.stems[0] is string
        && data.updatedAtMs is int
        && data.updatedAtMs >= 0
        && data.updatedAt == request.time;
    }

    match /users/{userId}/preferences/{prefId} {
      allow get: if isSignedIn() && isValidId(userId) && prefId == 'seriesCalibration' && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && prefId == 'seriesCalibration' && isOwner(userId)
        && isValidCalibrationPreference(incoming(), userId, prefId);
      allow update: if isVerified() && isValidId(userId) && prefId == 'seriesCalibration' && isOwner(userId)
        && isValidCalibrationPreference(incoming(), userId, prefId)
        && incoming().ownerId == existing().ownerId
        && incoming().prefId == existing().prefId
        && incoming().diff(existing()).affectedKeys().hasOnly(['baseSensitivity', 'calibration', 'examples', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && prefId == 'seriesCalibration' && isOwner(userId) && existing().ownerId == request.auth.uid;
    }

    match /users/{userId}/folders/{folderId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(folderId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && isValidId(folderId) && isOwner(userId)
        && isValidFolderProgress(incoming(), userId, folderId);
      allow update: if isVerified() && isValidId(userId) && isValidId(folderId) && isOwner(userId)
        && isValidFolderProgress(incoming(), userId, folderId)
        && incoming().ownerId == existing().ownerId
        && incoming().folderId == existing().folderId
        && incoming().diff(existing()).affectedKeys().hasOnly(['folderName', 'keepCount', 'trashCount', 'lastShotId', 'lastShotName', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isValidId(folderId) && isOwner(userId) && existing().ownerId == request.auth.uid;

      match /chunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(folderId) && isValidId(chunkId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(chunkId) && isOwner(userId)
          && isValidDecisionChunk(incoming(), userId, folderId)
          && existsAfter(/databases/$(database)/documents/users/$(userId)/folders/$(folderId));
        allow update: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(chunkId) && isOwner(userId)
          && isValidDecisionChunk(incoming(), userId, folderId)
          && incoming().ownerId == existing().ownerId
          && incoming().folderId == existing().folderId
          && incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId)/folders/$(folderId));
        allow delete: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(chunkId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }

      match /manualSeries/{seriesId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(folderId) && isValidId(seriesId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(seriesId) && isOwner(userId)
          && isValidManualSeriesDoc(incoming(), userId, folderId, seriesId)
          && existsAfter(/databases/$(database)/documents/users/$(userId)/folders/$(folderId));
        allow update: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(seriesId) && isOwner(userId)
          && isValidManualSeriesDoc(incoming(), userId, folderId, seriesId)
          && incoming().ownerId == existing().ownerId
          && incoming().folderId == existing().folderId
          && incoming().seriesId == existing().seriesId
          && incoming().diff(existing()).affectedKeys().hasOnly(['shotIds', 'stems', 'updatedAtMs', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId)/folders/$(folderId));
        allow delete: if isVerified() && isValidId(userId) && isValidId(folderId) && isValidId(seriesId) && isOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
